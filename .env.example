# 在飞书开放平台新建“企业自建应用”，开启机器人能力；不要使用群自定义 webhook 机器人
FEISHU_APP_ID=cli_REPLACE_ME
FEISHU_APP_SECRET=REPLACE_ME
# 第一台 TrueNAS 上现有 Prometheus；容器内要能访问这个地址
PROMETHEUS_URL=http://192.168.31.77:30104
SENSORS_CONFIG=/app/config/sensors.json
TIMEZONE=Asia/Shanghai
# 建议部署时填写允许查询的群聊chat_id；留空允许可用范围内的单聊及@机器人群聊
ALLOWED_CHAT_IDS=
LOG_LEVEL=INFO
